AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_AI_ACCOUNT=

# Optional context arms. Leave unset when a base model cannot be deployed raw.
RFT_BASE_DEPLOYMENT=
SFT_BASE_DEPLOYMENT=
TEACHER_DEPLOYMENT=gpt-5.5
TEACHER_REASONING_EFFORT=medium

RFT_MODEL=o4-mini
RFT_N_EPOCHS=2
RFT_REASONING_EFFORT=medium
RFT_COMPUTE_MULTIPLIER=2
RFT_LEARNING_RATE_MULTIPLIER=1.0
RFT_EVAL_INTERVAL=5
RFT_EVAL_SAMPLES=10
RFT_TRAINING_TYPE=GlobalStandard

SFT_MODEL=gpt-4.1-mini
SFT_N_EPOCHS=3
SFT_TRAINING_TYPE=GlobalStandard