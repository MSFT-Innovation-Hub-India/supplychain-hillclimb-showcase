# Copy this file to .env only when running paid captures, fine-tuning,
# deployments, evaluations, or the comparison app in Live Azure mode.
# Recorded replay in the comparison app does not require a .env file.

# Required for Azure model inference and fine-tuning management.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com

# Required only when deploying a completed fine-tuned model.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_AI_ACCOUNT=

# Required only for Live Azure mode in the comparison app. Use deployment
# names from your Azure AI resource; the historical deployments no longer exist.
SFT_DEPLOYMENT=
RFT_DEPLOYMENT=
TEACHER_DEPLOYMENT=gpt-5.2

# Optional pilot context arms. Leave blank when a base model cannot be deployed raw.
RFT_BASE_DEPLOYMENT=
SFT_BASE_DEPLOYMENT=

# Optional inference overrides. These values match the code defaults.
TEACHER_REASONING_EFFORT=medium
MODEL_REQUEST_TIMEOUT_SECONDS=600

# RFT submission settings. These values are required by the frozen first-run audit.
RFT_MODEL=o4-mini
RFT_N_EPOCHS=2
RFT_REASONING_EFFORT=medium
RFT_COMPUTE_MULTIPLIER=2
RFT_LEARNING_RATE_MULTIPLIER=1.0
RFT_EVAL_INTERVAL=5
RFT_EVAL_SAMPLES=10
RFT_TRAINING_TYPE=GlobalStandard

# SFT submission settings. These values match the code defaults.
SFT_MODEL=gpt-4.1-mini
SFT_SUFFIX=allocation-sft-v2
SFT_N_EPOCHS=3
SFT_TRAINING_TYPE=GlobalStandard